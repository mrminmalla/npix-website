{
  "name": "npix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@npix/web",
    "dev:api": "turbo run dev --filter=@npix/api",
    "dev:admin": "turbo run dev --filter=@npix/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @npix/api prisma:migrate",
    "db:seed": "pnpm --filter @npix/api prisma:seed",
    "db:studio": "pnpm --filter @npix/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
