NODE_ENV=development
PORT=4100

DATABASE_URL="postgresql://npix:npix@localhost:5432/npix?schema=public"

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_SECRET=change-me-cookie

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3005,http://localhost:3006

# Storage driver: "local" (dev) or "s3" (MinIO/S3-compatible, prod)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
PUBLIC_ASSET_BASE_URL=http://localhost:4100/uploads

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=npix-assets
S3_ACCESS_KEY_ID=npix
S3_SECRET_ACCESS_KEY=npix12345
S3_FORCE_PATH_STYLE=true

# Frontend revalidation webhook
WEB_REVALIDATE_URL=http://localhost:3005/api/revalidate
WEB_REVALIDATE_SECRET=change-me-revalidate

BOOTSTRAP_ADMIN_EMAIL=admin@npix.net.np
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
