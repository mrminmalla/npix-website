// NPIX CMS database schema
// See /docs/architecture (or the approved technical plan) for the rationale
// behind each table and what stays out of the database on purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  uploadedAssets Asset[]     @relation("AssetUploadedBy")
  newsAuthored   NewsEvent[] @relation("NewsAuthor")
  auditLogs      AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  diff        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}

// ── Media ─────────────────────────────────────────────────────────────────

model Asset {
  id               String    @id @default(uuid())
  storageKey       String    @unique @map("storage_key")
  url              String
  originalFilename String    @map("original_filename")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  width            Int?
  height           Int?
  altText          String?   @map("alt_text")
  uploadedById     String?   @map("uploaded_by")
  uploadedBy       AdminUser? @relation("AssetUploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")

  members       Member[]
  teamMembers   TeamMember[]
  newsEvents    NewsEvent[]      @relation("NewsFeaturedImage")
  documentFiles Document[]       @relation("DocumentFile")
  documentPreviews Document[]    @relation("DocumentPreview")

  @@map("assets")
}

// ── Members ───────────────────────────────────────────────────────────────

enum MemberCategory {
  regular
  special
}

model Member {
  id             String         @id @default(uuid())
  name           String
  asn            String
  website        String?
  ipAddress      String?        @map("ip_address")
  ipv6Address    String?        @map("ipv6_address")
  datahubIp      String?        @map("datahub_ip")
  datahubIpv6    String?        @map("datahub_ipv6")
  category       MemberCategory @default(regular)
  logoAssetId    String?        @map("logo_asset_id")
  logoAsset      Asset?         @relation(fields: [logoAssetId], references: [id])
  sortOrder      Int            @default(0) @map("sort_order")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([category])
  @@index([asn])
  @@map("members")
}

// ── News & Events ─────────────────────────────────────────────────────────

enum NewsCategory {
  Announcements
  Maintenance
  NewMembers  @map("New Members")
  Workshops
  Conferences
  Upgrades
}

enum ContentStatus {
  draft
  published
}

model NewsEvent {
  id                 String        @id @default(uuid())
  slug               String        @unique
  title              String
  category           NewsCategory
  summary            String
  content            String
  location           String?
  featuredImageAssetId String?     @map("featured_image_asset_id")
  featuredImageAsset Asset?        @relation("NewsFeaturedImage", fields: [featuredImageAssetId], references: [id])
  isFeatured         Boolean       @default(false) @map("is_featured")
  status             ContentStatus @default(published)
  publishedAt        DateTime      @map("published_at")
  authorId           String?       @map("author_id")
  author             AdminUser?    @relation("NewsAuthor", fields: [authorId], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([category])
  @@index([publishedAt])
  @@map("news_events")
}

// ── Documentation ─────────────────────────────────────────────────────────

model DocumentCategory {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  description String
  iconName    String     @map("icon_name")
  sortOrder   Int        @default(0) @map("sort_order")
  documents   Document[]

  @@map("document_categories")
}

model Document {
  id             String            @id @default(uuid())
  title          String
  description    String
  categoryId     String            @map("category_id")
  category       DocumentCategory  @relation(fields: [categoryId], references: [id])
  tags           String[]          @default([])
  fileType       String            @map("file_type")
  fileSize       String?           @map("file_size")
  version        String?
  publishDate    DateTime          @map("publish_date")
  updatedDate    DateTime          @map("updated_date")
  fileAssetId    String?           @map("file_asset_id")
  fileAsset      Asset?            @relation("DocumentFile", fields: [fileAssetId], references: [id])
  previewAssetId String?           @map("preview_asset_id")
  previewAsset   Asset?            @relation("DocumentPreview", fields: [previewAssetId], references: [id])
  content        Json?
  isFeatured     Boolean           @default(false) @map("is_featured")
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("documents")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  @@map("faqs")
}

// ── About page ────────────────────────────────────────────────────────────

model CoreValue {
  id          String @id @default(uuid())
  title       String
  description String
  iconName    String @map("icon_name")
  sortOrder   Int    @default(0) @map("sort_order")

  @@map("core_values")
}

model TimelineEntry {
  id          String @id @default(uuid())
  year        String
  title       String
  description String
  sortOrder   Int    @default(0) @map("sort_order")

  @@map("timeline_entries")
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String
  bio          String
  photoAssetId String?  @map("photo_asset_id")
  photoAsset   Asset?   @relation(fields: [photoAssetId], references: [id])
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("team_members")
}

// Generic editable prose blocks for About (Who We Are, What is an IXP,
// Why NPIX Exists, Mission, Vision). Not used for any other page today.
model PageSection {
  id          String @id @default(uuid())
  pageSlug    String @map("page_slug")
  sectionKey  String @map("section_key")
  eyebrow     String?
  heading     String
  body        String
  iconName    String? @map("icon_name")
  sortOrder   Int    @default(0) @map("sort_order")

  @@unique([pageSlug, sectionKey])
  @@map("page_sections")
}

// ── Home / Statistics ─────────────────────────────────────────────────────

enum StatSection {
  home
  traffic_insights
  infrastructure
}

model StatCard {
  id          String      @id @default(uuid())
  section     StatSection
  label       String
  value       Float
  prefix      String?
  suffix      String?
  decimals    Int         @default(0)
  iconName    String      @map("icon_name")
  description String?
  sortOrder   Int         @default(0) @map("sort_order")

  @@index([section])
  @@map("stat_cards")
}

// Singleton row (enforced at the application layer)
model ProtocolAdoption {
  id                String   @id @default(uuid())
  ipv4SharePercent  Int      @map("ipv4_share_percent")
  ipv6SharePercent  Int      @map("ipv6_share_percent")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("protocol_adoption")
}

model PointOfPresence {
  id          String  @id @default(uuid())
  name        String
  city        String
  description String
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  @@map("points_of_presence")
}

model TrafficPanel {
  id        String  @id @default(uuid())
  label     String
  sublabel  String
  embedUrl  String  @map("embed_url")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("traffic_panels")
}

model WhyNpixItem {
  id          String @id @default(uuid())
  title       String
  description String
  iconName    String @map("icon_name")
  sortOrder   Int    @default(0) @map("sort_order")

  @@map("why_npix_items")
}

// ── Site-wide settings ────────────────────────────────────────────────────

model SiteSetting {
  key         String  @id
  value       String
  description String?

  @@map("site_settings")
}
